generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}



model Producto {
  id                String              @id
  nombreProducto    String
  marca             String
  presentacion      String
  idCategoria       String
  imagen            String?

  HistorialPrecios  HistorialPrecios[]
  PreciosUnificados PreciosUnificados[]
  Categoria         Categoria           @relation(fields: [idCategoria], references: [id])
}

model Supermercado {
  id                String              @id
  nombre            String              @unique

  PreciosUnificados PreciosUnificados[]
  Sucursal          Sucursal[]
}

model Sucursal {
  id             String       @id
  nombre         String
  direccion      String
  latitud        Float
  longitud       Float
  supermercadoId String

  Supermercado   Supermercado @relation(fields: [supermercadoId], references: [id])
}

model HistorialPrecios {
  id             String
  fechaGuardado  DateTime
  precioPromedio Float

  Producto       Producto @relation(fields: [id], references: [id])
  @@id([id, fechaGuardado])
}

model precioDolar {
  fechaGuardado  DateTime @id
  precioPromedio Float
}

model Categoria {
  id       String     @id
  nombre   String     @unique

  Producto Producto[]
}

model PreciosUnificados {
  id             String       @id
  idProducto     String
  idSupermercado String
  precio         Float        @db.Real
  actualizacion  DateTime     @default(now())

  Carrito        Carrito[] 
  Producto       Producto     @relation(fields: [idProducto], references: [id])
  Supermercado   Supermercado @relation(fields: [idSupermercado], references: [id])  
}

model Usuario {
  id            String   @id
  nombreUsuario String
  email         String   @unique
  telefono      String   @unique
  Carrito       Carrito?
}

model Carrito {
  id                String              @id
  usuarioId         String              @unique

  Usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  PreciosUnificados PreciosUnificados[] 
}


