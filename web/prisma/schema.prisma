// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "/prisma"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id              Int                 @id
  categoria       String
  nombreProducto  String
  marca           String
  imagen          String?
  historialPrecio HistorialPrecios[]  @relation("tieneHistorial")
  precios         PreciosUnificados[] @relation("preciosSupers")
  precioDolars    precioDolar[]       @relation("historialDolar")
}

model Supermercado {
  id                Int                 @id
  nombre            String              @unique
  sucursales        Int
  preciosUnificados PreciosUnificados[] @relation("nombreDelSuper")
}

model HistorialPrecios {
  id             Int
  fechaGuardado  DateTime
  precioPromedio Decimal
  producto       Producto @relation("tieneHistorial", fields: [id], references: [id])

  @@id([id, fechaGuardado])
}

model precioDolar {
  id             Int
  fechaGuardado  DateTime
  precioPromedio Decimal
  producto       Producto @relation("historialDolar", fields: [id], references: [id])

  @@id([id, fechaGuardado])
}

//precioDolar - misma idea historial de precios.x
model PreciosUnificados {
  id            Int          @id @default(autoincrement())
  idProducto    Int
  nombreSuper   String
  precio        Decimal
  actualizacion DateTime     @default(now())
  producto      Producto     @relation("preciosSupers", fields: [id], references: [id])
  nomSuper      Supermercado @relation("nombreDelSuper", fields: [nombreSuper], references: [nombre])
  carritos      Carrito[]    @relation("CarritoPrecios")
}

model Usuario {
  id            Int     @id
  nombreUsuario String
  email         String  @unique
  telefono      Int     @unique
  carrito       Carrito?
}

model Carrito {
  id        Int                 @id @default(autoincrement())
  usuarioId Int                 @unique
  usuario   Usuario             @relation(fields: [usuarioId], references: [id])
  precios   PreciosUnificados[] @relation("CarritoPrecios")
}
