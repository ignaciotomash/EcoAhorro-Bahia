// ============================================================
// SCHEMA PRISMA — Consistente con el Modelo ER (3FN)
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "/prisma"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id                Int                 @id
  categoria         String
  nombreProducto    String
  marca             String
  imagen            String?

  historialPrecios  HistorialPrecios[]  @relation("tieneHistorial")
  preciosUnificados PreciosUnificados[] @relation("preciosSupers")
}

model Supermercado {
  id                Int                 @id
  nombre            String              @unique

  sucursales        Sucursal[]
  preciosUnificados PreciosUnificados[] @relation("nombreDelSuper")
}

model Sucursal {
  id             Int          @id @default(autoincrement())
  nombre         String
  direccion      String
  latitud        Float
  longitud       Float
  supermercadoId Int

  supermercado   Supermercado @relation(fields: [supermercadoId], references: [id])
}

model HistorialPrecios {
  idProducto     Int
  fechaGuardado  DateTime
  precioPromedio Decimal

  producto       Producto @relation("tieneHistorial", fields: [idProducto], references: [id])

  @@id([idProducto, fechaGuardado])
}

model PrecioDolar {
  fechaGuardado  DateTime @id
  precioPromedio Decimal
}

model PreciosUnificados {
  id            Int          @id @default(autoincrement())
  idProducto    Int
  nombreSuper   String
  precio        Decimal
  actualizacion DateTime     @default(now())

  producto      Producto     @relation("preciosSupers", fields: [idProducto], references: [id])
  supermercado  Supermercado @relation("nombreDelSuper", fields: [nombreSuper], references: [nombre])
  carritos      Carrito[]    @relation("CarritoPrecios")
}

model Usuario {
  id            Int      @id
  nombreUsuario String
  email         String   @unique
  telefono      Int      @unique

  carrito       Carrito?
}

model Carrito {
  id        Int    @id @default(autoincrement())
  usuarioId Int    @unique

  usuario   Usuario             @relation(fields: [usuarioId], references: [id])
  precios   PreciosUnificados[] @relation("CarritoPrecios")
}