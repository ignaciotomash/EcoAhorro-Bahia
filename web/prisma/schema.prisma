generator client {
  provider = "prisma-client-js"
  output   = "/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Carrito {
  id                Int                 @id @default(autoincrement())
  usuarioId         Int                 @unique
  Usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  PreciosUnificados PreciosUnificados[] @relation("CarritoPrecios")
}

model Categoria {
  id       Int        @id
  nombre   String     @unique
  Producto Producto[]
}

model HistorialPrecios {
  id             BigInt
  fechaGuardado  DateTime
  precioPromedio Decimal
  Producto       Producto @relation(fields: [id], references: [id])
  @@id([id, fechaGuardado])
}

model PreciosUnificados {
  id             BigInt       @id @default(autoincrement())
  idProducto     BigInt
  idSupermercado Int
  precio         Float        @db.Real
  actualizacion  DateTime     @default(now())
  Producto       Producto     @relation(fields: [idProducto], references: [id])
  Supermercado   Supermercado @relation(fields: [idSupermercado], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Carrito        Carrito[]    @relation("CarritoPrecios")
}

model Producto {
  id                BigInt              @id
  nombreProducto    String
  marca             String
  imagen            String?
  presentacion      String
  idCategoria       Int
  HistorialPrecios  HistorialPrecios[]
  PreciosUnificados PreciosUnificados[]
  Categoria         Categoria           @relation(fields: [idCategoria], references: [id])
  precioDolar       precioDolar[]
}

model Sucursal {
  id             Int          @id @default(autoincrement())
  nombre         String
  direccion      String
  latitud        Float
  longitud       Float
  supermercadoId Int
  Supermercado   Supermercado @relation(fields: [supermercadoId], references: [id])
}

model Supermercado {
  id                Int                 @id
  nombre            String              @unique
  PreciosUnificados PreciosUnificados[]
  Sucursal          Sucursal[]
}

model Usuario {
  id            Int      @id
  nombreUsuario String
  email         String   @unique
  telefono      Int      @unique
  Carrito       Carrito?
}

model precioDolar {
  id             BigInt
  fechaGuardado  DateTime
  precioPromedio Decimal
  Producto       Producto @relation(fields: [id], references: [id])

  @@id([id, fechaGuardado])
}
