// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id              Int                 @id
  nombreProducto  String
  marca           String
  presentacion    String
  idCategoria     Int
  imagen          String?
  historialPrecio HistorialPrecios[]  @relation("tieneHistorial")
  precios         PreciosUnificados[] @relation("preciosSupers")
  precioDolars    precioDolar[]       @relation("historialDolar")
  categoria       Categoria           @relation(fields: [idCategoria], references: [id])
}

model Categoria {
  id        Int        @id
  nombre    String     @unique
  productos Producto[]
}

model Supermercado {
  id                Int                 @id
  nombre            String              @unique
  sucursales        Sucursal[]
  preciosUnificados PreciosUnificados[] @relation("nombreDelSuper")
}

model Sucursal {
  id             Int          @id @default(autoincrement())
  nombre         String
  direccion      String
  latitud        Float
  longitud       Float
  supermercadoId Int
  supermercado   Supermercado @relation(fields: [supermercadoId], references: [id])
}

model HistorialPrecios {
  id             Int
  fechaGuardado  DateTime
  precioPromedio Decimal
  producto       Producto @relation("tieneHistorial", fields: [id], references: [id])

  @@id([id, fechaGuardado])
}

model precioDolar {
  id             Int
  fechaGuardado  DateTime
  precioPromedio Decimal
  producto       Producto @relation("historialDolar", fields: [id], references: [id])

  @@id([id, fechaGuardado])
}

//precioDolar - misma idea historial de precios.x
model PreciosUnificados {
  id            Int          @id @default(autoincrement())
  idProducto    Int
  nombreSuper   String
  precio        Decimal
  actualizacion DateTime     @default(now())
  producto      Producto     @relation("preciosSupers", fields: [idProducto], references: [id])
  nomSuper      Supermercado @relation("nombreDelSuper", fields: [nombreSuper], references: [nombre])
  carritos      Carrito[]    @relation("CarritoPrecios")
}

model Usuario {
  id            Int      @id
  nombreUsuario String
  email         String   @unique
  telefono      Int      @unique
  carrito       Carrito?
}

model Carrito {
  id        Int                 @id @default(autoincrement())
  usuarioId Int                 @unique
  usuario   Usuario             @relation(fields: [usuarioId], references: [id])
  precios   PreciosUnificados[] @relation("CarritoPrecios")
}
