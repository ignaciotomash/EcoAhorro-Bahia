generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Carrito {
  id                String              @id
  usuarioId         String              @unique
  Usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  PreciosUnificados PreciosUnificados[] @relation("CarritoPrecios")
}

model Categoria {
  id       String     @id
  nombre   String     @unique
  Producto Producto[]
}

model HistorialPrecios {
  id             String
  fechaGuardado  DateTime
  precioPromedio Decimal
  Producto       Producto @relation(fields: [id], references: [id])

  @@id([id, fechaGuardado])
}

model PreciosUnificados {
  id             String       @id
  idProducto     String
  idSupermercado String
  precio         Float        @db.Real
  actualizacion  DateTime     @default(now())
  Producto       Producto     @relation(fields: [idProducto], references: [id])
  Supermercado   Supermercado @relation(fields: [idSupermercado], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Carrito        Carrito[]    @relation("CarritoPrecios")
}

model Producto {
  id                String              @id
  nombreProducto    String
  marca             String
  presentacion      String
  idCategoria       String
  imagen            String?
  HistorialPrecios  HistorialPrecios[]
  PreciosUnificados PreciosUnificados[]
  Categoria         Categoria           @relation(fields: [idCategoria], references: [id])
  precioDolar       precioDolar[]
}

model Sucursal {
  id             String       @id
  nombre         String
  direccion      String
  latitud        Float
  longitud       Float
  supermercadoId String
  Supermercado   Supermercado @relation(fields: [supermercadoId], references: [id])
}

model Supermercado {
  id                String              @id
  nombre            String              @unique
  PreciosUnificados PreciosUnificados[]
  Sucursal          Sucursal[]
}

model Usuario {
  id            String   @id
  nombreUsuario String
  email         String   @unique
  telefono      String   @unique
  Carrito       Carrito?
}

model precioDolar {
  id             String
  fechaGuardado  DateTime
  precioPromedio Decimal
  Producto       Producto @relation(fields: [id], references: [id])

  @@id([id, fechaGuardado])
}
